# gateway-go  ·  go run ./cmd/gateway-go
PORT=:8081
ENV=development

# A provider is registered only if its primary credential is set, so you can
# run with just one configured.

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_BASE_URL=https://api.razorpay.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_BASE_URL=https://api.stripe.com

# --- Cashfree ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
# sandbox: https://sandbox.cashfree.com | live: https://api.cashfree.com
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox: https://api-m.sandbox.paypal.com | live: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# GATEWAY_TLS_CERT=/etc/tls/gateway.crt
# GATEWAY_TLS_KEY=/etc/tls/gateway.key