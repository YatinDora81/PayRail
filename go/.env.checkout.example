PORT=:8080
ENV=development
DATABASE_URL=postgres://payrail:payrail@localhost:5432/payrail?sslmode=disable
REDIS_URL=redis://localhost:6379

# gateway-go (opens the payment order at the real provider)
GATEWAY_TARGET=localhost:8081
GATEWAY_TLS=false

# How long a CREATED order stays claimable before the sweeper expires it
ORDER_TTL=15m