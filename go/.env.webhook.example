# webhook-ingest · go run ./cmd/webhook-ingest
ENV=development
PORT=:8082

# Postgres — webhook-ingest persists WebhookEvents (eventId dedupe + raw-body
# evidence) and the OutboxEvent the relay publishes, in one transaction.
DATABASE_URL=postgres://payrail:payrail@localhost:5432/payrail?sslmode=disable

# gateway-go (verifies provider webhook signatures)
GATEWAY_TARGET=localhost:8081
GATEWAY_TLS=false